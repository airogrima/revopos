# Copy to .env and fill in. .env is gitignored — never commit real values.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Preview-only auto sign-in. Removed once Phase 3 adds real auth.

# --------------------------------------------------------- Support contact
# Shown on Help & Support. If both are blank the screen says in-app support is
# not set up rather than offering a button that opens nothing.
#
# WhatsApp is digits only, international format WITHOUT the +, e.g.
# 2348012345678 — wa.me rejects a leading plus or any spaces.
EXPO_PUBLIC_SUPPORT_EMAIL=
EXPO_PUBLIC_SUPPORT_WHATSAPP=

# Where the password-reset email link lands. The web app handles the reset;
# the phone only asks for the email.
EXPO_PUBLIC_APP_URL=https://revopass.revospace.ng

# Off by default (store builds must not sell subscriptions with Squad). 1 = sideloaded preview APK only.
EXPO_PUBLIC_ENABLE_WEB_CHECKOUT=
